# API de notificações — valores REAIS só nas variáveis secretas do Render (Environment).
# Este arquivo lista apenas os NOMES; nunca commite o `.env` real.

PORT=3000
FIREBASE_PROJECT_ID=seu-project-id
FIREBASE_CLIENT_EMAIL=email-da-conta-de-servico@seu-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=CONFIGURAR_APENAS_NA_HOSPEDAGEM
FIREBASE_DATABASE_URL=https://seu-project-id-default-rtdb.firebaseio.com

# Opcional — somente se "Enhanced push security" estiver ativo no projeto Expo (iOS via Expo Push Service)
EXPO_ACCESS_TOKEN=
